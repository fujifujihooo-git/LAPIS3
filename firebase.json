{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "brain/**",
      ".gemini/**",
      "media__*",
      "start_emulator.bat",
      "emulator_data",
      "firestore-debug.log",
      "create_verification_data.js",
      "*.log",
      "*.bat",
      "*.exe",
      "*.sh",
      "_BACKUP_*",
      "**/*.bat",
      "**/*.exe"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "firestore": {
      "port": 8085
    },
    "auth": {
      "port": 9095
    },
    "ui": {
      "enabled": true,
      "port": 4005
    },
    "hosting": {
      "port": 5005
    },
    "singleProjectMode": true
  }
}
